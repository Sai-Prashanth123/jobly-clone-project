PORT=3001
NODE_ENV=development

# Supabase — Project Settings → API
SUPABASE_URL=https://ufkrfrmqangydrjbzljo.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...
SUPABASE_ANON_KEY=eyJ...anon...

# Postgres direct connection — only needed for `npx prisma` CLI tooling;
# the runtime uses supabase-js (SUPABASE_URL + SERVICE_ROLE_KEY) instead.
# URL-encode special chars in the password: @ → %40, $ → %24, ! → %21
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.ufkrfrmqangydrjbzljo.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.ufkrfrmqangydrjbzljo.supabase.co:5432/postgres

FRONTEND_URL=http://localhost:8080

# Optional — if unset, welcome/invoice emails are disabled with a warning.
# Generate at: myaccount.google.com → Security → 2-Step Verification → App passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=
